# Etnia Bot — environment template.
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# Required vars are uncommented; phase-gated vars are commented out
# until that phase is reached.

# === App-level ===
APP_ENV=development              # development | staging | production
LOG_LEVEL=INFO


# === Postgres (CRM Supabase project) — required from Phase B ===
# Use the DIRECT connection URI from Supabase (port 5432), not the
# pooler. Note the `+asyncpg` driver suffix — required for SQLAlchemy
# async, even though Supabase shows the URL without it.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres


# === OpenAI ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# === Bot tuning ===
BOT_MAX_TURNS=10
BOT_TIMEOUT_HOURS=1
LLM_HISTORY_WINDOW=30
SESSION_TTL_SECONDS=604800       # 7 days; legacy, removed when Redis is removed


# === Chatwoot — required from Phase C ===
# CHATWOOT_BASE_URL=https://crm.etniaviajes.com.ar
# CHATWOOT_ACCOUNT_ID=1
# CHATWOOT_BOT_ACCESS_TOKEN=
# CHATWOOT_WEBHOOK_SECRET=


# === Webpage Supabase (read-only catalog) — required from Phase E ===
# WEB_SUPABASE_URL=https://<webpage-ref>.supabase.co
# WEB_SUPABASE_ANON_KEY=


# ========================================================================
# === Legacy section — removed during Phase C cutover ===================
# ========================================================================

# WhatsApp adapter (WPPConnect bridge). Replaced by Chatwoot.
WPP_ADAPTER_URL=
AUTH_SESSION_KEY=

# Redis: bot session cache. Replaced by Postgres-backed bot_states.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# Redis worker (Celery broker).
WORKER_REDIS_HOST=localhost
WORKER_REDIS_PORT=6379
WORKER_REDIS_USER=
WORKER_REDIS_PASSWORD=

# Google Drive (offers/ads JSON files). The bot still reads these in
# Phase B; replaced by the Postgres `offers` table in Phase E.
SERVICE_ACCOUNT_FILE=etc/secrets/gdrive.json
TOKEN_FILE=etc/secrets/token.json
ADS_FILE_PATH=etc/secrets/ads.json
OFFERS_DB_PATH=etc/secrets/offers.json
FOLDER_ID=
FOLDER_ID_SEASONAL=
FOLDER_ID_GRUPAL=

# Google Sheets (pseudo-database for leads). Replaced by Postgres CRM
# tables in Phase C; the migration script in Phase E reads from this
# one last time before it is removed.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=etc/secrets/gsheets.json
